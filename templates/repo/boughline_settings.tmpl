{{template "base/head" .}}
<main class="page-content repository">
 {{template "repo/header" .}}
 <div class="ui container">
  <h1>Project settings</h1>
  <dl><dt>Native repository</dt><dd><code>{{.BoughID}}</code></dd><dt>Source control client</dt><dd><code>bough</code></dd></dl>
